# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
NEXTAUTH_SECRET=
NVIDIA_API_KEY=
MINIMAX_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
CLOUDFLARE_API_TOKEN=
VERCEL_TOKEN=

# --- Communication Hub (Sprint C0) ---
# Provider credentials. communication_providers.credentials_secret_ref may ONLY name one of these
# (or a name in the same provider namespace: COMM_RESEND_*, COMM_SMTP_*, COMM_META_*, COMM_MSG91_*).
# Any other name is rejected. Never put a value here; set real values in the deployment secret store.
SMTP_PASSWORD=
META_WHATSAPP_ACCESS_TOKEN=
MSG91_AUTH_KEY=
# Per-organization rolling-24h send quotas (defaults: email 1000, sms 200, whatsapp 500). 0 disables a channel.
# COMM_QUOTA_EMAIL_PER_DAY=
# COMM_QUOTA_SMS_PER_DAY=
# COMM_QUOTA_WHATSAPP_PER_DAY=
# Per-organization requests/minute (defaults: send 20, retry 10, template writes 30). In-memory, per instance.
# COMM_SEND_RATE_LIMIT_PER_MINUTE=
# COMM_RETRY_RATE_LIMIT_PER_MINUTE=
# COMM_WRITE_RATE_LIMIT_PER_MINUTE=
# --- Communication Hub: campaigns (Sprint CH-02) ---
# COMM_CAMPAIGN_MAX_RECIPIENTS=      (default 5000 recipients per campaign)
# COMM_CAMPAIGN_BATCH_SIZE=          (default 100 messages queued per worker batch)
# COMM_CAMPAIGN_RATE_LIMIT_PER_MINUTE=  (default 10 test/schedule/execute/cancel calls per org)
# COMM_HEALTH_RATE_LIMIT_PER_MINUTE=    (default 6 provider health checks per org)
# Unsubscribe (both required before an EMAIL campaign can be scheduled or executed; fails closed when unset).
# COMM_UNSUBSCRIBE_SECRET signs the one-click unsubscribe links (>= 32 random chars; rotating it invalidates old links).
# COMM_PUBLIC_BASE_URL is the public https origin of THIS server, e.g. https://os.example.com (no path).
COMM_UNSUBSCRIBE_SECRET=
COMM_PUBLIC_BASE_URL=
# Meta WhatsApp webhook (both required before /api/communications/webhooks/meta-whatsapp accepts anything):
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Worker trigger secret (also stored as an InsForge secret; see docs/project/CH02_INSFORGE_WORKER_SCHEDULE_RUNBOOK.md):
CRON_SECRET=
